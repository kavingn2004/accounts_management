# Copy this file to `supabase.env` (which is git-ignored) and fill in the two
# values from your Supabase project: Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-anon-public-key

# --- Ask (optional) -----------------------------------------------------
# Where the chat finds a language model. Leave blank and Ask answers from its
# keyword router — instant, and correct on every question in the test corpus.
#
# Local development:   http://localhost:11434/v1     (Ollama, no key needed)
# Deployed on Netlify:  set nothing here — the Netlify build passes /api,
#                       which its own function proxies to Groq using a key
#                       kept server-side (see netlify/functions/ask-llm.mjs).
# Anywhere else:        https://your-proxy/v1         (a server you control)
#
# Never point a deployed build straight at a provider: ASK_LLM_KEY would be
# readable in main.dart.js by anyone who opens the site. That is what the
# proxy exists to avoid, and tool/build_web.sh refuses to build with a key set.
#
# To test the deployed proxy from a local production build, set:
#   ASK_LLM_URL=https://your-site.netlify.app/api
ASK_LLM_URL=
ASK_LLM_MODEL=qwen2.5-coder:7b
ASK_LLM_KEY=

# --- Ask, server side ---------------------------------------------------
# Read only by netlify/functions/ask-llm.mjs, never compiled into the app.
# Keep it here for `node tool/check_ask_proxy.mjs`, and set the same value in
# the Netlify dashboard (Site settings -> Environment variables) for the
# deployed site. This file is git-ignored; the dashboard copy is the one the
# live site uses.
#
# Note the difference from ASK_LLM_KEY above: that one would be readable by
# anyone who opens the site, which is why it must stay empty. This one is not.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
